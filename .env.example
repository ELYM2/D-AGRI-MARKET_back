# Django Settings
# Generate a secure secret key for production: https://djecrety.ir/
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=1

# Cookie Settings (optional, defaults are fine for local dev)
# AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_SECURE=0
# AUTH_COOKIE_SAMESITE=Lax
# ACCESS_TOKEN_COOKIE_NAME=access
# REFRESH_TOKEN_COOKIE_NAME=refresh

# PostgreSQL Database (optional - if not set, uses SQLite)
# Uncomment and configure if you want to use PostgreSQL instead of SQLite
# POSTGRES_DB=appback_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Alternative: Use DATABASE_URL (for services like Render, Heroku, etc.)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Frontend URL (for CORS - optional, localhost:3000 is already included)
# FRONTEND_URL=https://your-frontend-domain.com
